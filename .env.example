# Copy to .env (optional for local use — every value has a safe default). NEVER commit .env.

# ---------- App ----------
PORT=4310                 # HTTP port
NODE_ENV=development      # "production" → Secure cookies, no demo seed, no dev links
SESSION_TTL_HOURS=168     # Session lifetime
PUBLIC_URL=http://localhost:4310   # Base URL used in emailed links
SEED_ON_EMPTY=1           # 1 = load synthetic demo data when the database is empty
DEV_LINKS=                # 1 = show the email-verification link on screen to the account owner (default: on in development, off in production)
DEV_RESET_LINKS=          # 1 = show password-reset links on screen. NEVER on a public server (default: on in development only)
COOKIE_SECURE=            # 1/0 override (default: on in production)
OUTBOX_DIR=./data/outbox  # Emails are written here as .eml files — no email provider is connected

# ---------- Database ----------
# SQLite (default, zero install):
DB_FILE=./data/dara.db
# PostgreSQL with row-level security (set this to switch). Connect as a NON-superuser — superusers bypass RLS.
# DATABASE_URL=postgres://dara_owner:change-me@localhost:5432/dara
PG_APP_ROLE=dara_app      # role assumed inside every transaction
PG_POOL_MAX=10

# ---------- Secrets ----------
# Encrypts two-step sign-in secrets at rest (AES-256-GCM). Required in production. Generate: openssl rand -base64 32
# Losing or changing it means everyone must set up two-step sign-in again.
DARA_SECRET_KEY=

# ---------- docker compose only ----------
POSTGRES_PASSWORD=        # Postgres superuser (used only to create roles on first start)
DARA_DB_PASSWORD=         # password for the app's dara_owner login
APP_PORT=4310
