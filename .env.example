# Copy to .env (optional). All values have safe local defaults.
PORT=4310                 # HTTP port
DB_FILE=./data/dara.db    # SQLite database file (created automatically)
SESSION_TTL_HOURS=168     # Session lifetime
NODE_ENV=development      # set to "production" to mark cookies Secure (requires HTTPS)
SEED_ON_EMPTY=1           # 1 = load synthetic demo data when the database is empty
